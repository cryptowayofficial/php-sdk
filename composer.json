{
    "name": "cryptoway/php-sdk",
    "description": "PHP SDK for the Cryptoway crypto payment gateway: request-signing, invoice creation, webhook verification and the money rules the shop plugins run on.",
    "type": "library",
    "keywords": [
        "cryptoway",
        "payment",
        "payment-gateway",
        "cryptocurrency",
        "crypto",
        "bitcoin",
        "usdt",
        "invoice",
        "webhook",
        "hmac",
        "sdk"
    ],
    "homepage": "https://cryptoway.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Cryptoway",
            "homepage": "https://cryptoway.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/cryptowayofficial/php-sdk/issues",
        "source": "https://github.com/cryptowayofficial/php-sdk",
        "docs": "https://docs.cryptoway.com"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Cryptoway\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cryptoway\\Core\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
